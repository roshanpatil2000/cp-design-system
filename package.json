{
  "name": "cp-design-system-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "yarn workspace cp-design-system build",
    "dev": "yarn workspace cp-design-system dev",
    "test": "yarn workspace cp-design-system test",
    "typecheck": "yarn workspace cp-design-system typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "yarn workspace storybook storybook",
    "example": "yarn workspace expo-example start",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "yarn build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0"
  },
  "resolutions": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "@types/react": "~19.2.18"
  },
  "engines": {
    "node": ">=20"
  }
}
