{
  "name": "cp-design-system",
  "version": "0.2.0",
  "description": "Cross-platform design system for React (web) and React Native, sharing one set of tokens and component APIs.",
  "license": "MIT",
  "author": "roshanpatil2000",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roshanpatil2000/cp-design-system.git",
    "directory": "packages/cp-design-system"
  },
  "homepage": "https://github.com/roshanpatil2000/cp-design-system#readme",
  "bugs": "https://github.com/roshanpatil2000/cp-design-system/issues",
  "keywords": [
    "design-system",
    "react",
    "react-native",
    "expo",
    "ui",
    "components",
    "cross-platform"
  ],
  "sideEffects": false,
  "main": "./dist/web/index.cjs",
  "module": "./dist/web/index.mjs",
  "types": "./dist/index.d.ts",
  "react-native": "./dist/native/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/native/index.js",
      "import": "./dist/web/index.mjs",
      "require": "./dist/web/index.cjs"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/web/tokens.mjs",
      "require": "./dist/web/tokens.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "sync-tokens": "node scripts/sync-atlassian-tokens.mjs && prettier --write src/tokens/atlassian",
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "yarn test:web && yarn test:native",
    "test:web": "vitest run",
    "test:native": "jest",
    "prepublishOnly": "yarn typecheck && yarn test && yarn build && yarn check:worklets",
    "check:worklets": "node scripts/check-worklets.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.78",
    "react-native-gesture-handler": ">=2.20.0",
    "react-native-reanimated": ">=4.0.0",
    "react-native-worklets": ">=0.5.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "react-native-gesture-handler": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    },
    "react-native-worklets": {
      "optional": true
    }
  },
  "devDependencies": {
    "@atlaskit/tokens": "20.4.1",
    "@babel/core": "^7.28.0",
    "@jest/globals": "^29.7.0",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/react-native": "^14.1.0",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "~19.2.18",
    "jest": "^29.7.0",
    "jsdom": "^30.1.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "test-renderer": "^1.3.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "motion": "^14.0.0"
  }
}
